# Server Configuration
PORT=5001
NODE_ENV=development

FRONTEND_URL = http://localhost:5173/

# Database (if using MongoDB)
MONGODB_URI=

# Solana Configuration
SOLANA_CLUSTER=devnet
# Admin wallet secret key (Base58 encoded)
ADMIN_SECRET_KEY=your_base58_encoded_admin_secret_key ( Not in Use )
JWT_SECRET=your_jwt_secret_key ( Not in Use )

# API Security
ADMIN_API_KEY=your_admin_api_key ( Not in Use )
ADMIN_SECRET_TOKEN=your_admin_secret_token ( Not in Use )
ADMIN_SECRET_TOKEN_EXPIERS_IN=50000 # 5 minutes in seconds

# Authentication

JWT_EXPIRES_IN=7d
AUTH_NONCE_TTL_MINUTES=5
ACTIVATION_TOKEN_TTL_HOURS=24

# Transactional email (Resend). Without this, activation links are only logged
# to the server console and returned in development responses.
# Not Implemented Yet
RESEND_API_KEY=
MAIL_FROM=DegreeNFT <onboarding@resend.dev>
    
ADMIN_NAME=Arnab Mukherjee
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_WALLET_ADDRESSES=

# IPFS pinning (server-side only; never put these in the frontend)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
# Optional: custom Solana RPC for mint verification (defaults to public cluster URL)
SOLANA_RPC_URL=

# Encrypts secrets saved in Admin > Settings (SMTP password). 64 hex chars; changing it makes saved passwords unreadable.
SETTINGS_ENCRYPTION_KEY=generate-with-node-e-console.log(require('crypto').randomBytes(32).toString('hex'))

# On-chain credentials (Metaplex Core). See solana-poc/FINDINGS.md for the permission model.
# Platform wallet that pays every chain fee and rent (base58 secret key, or a JSON byte array). Keep it funded.
PLATFORM_FEE_PAYER_SECRET_KEY=
# Public address colleges pay into (SOL or USDC). Use a protected / multisig wallet; the server never needs its key.
DEGREENFT_TREASURY_ADDRESS=
# Optional: USDC token mint (defaults: Circle Devnet USDC on devnet, Circle USDC on mainnet)
USDC_MINT=
# Mainnet writes (collections, mints, recovery, burn) are refused until this is "true". Set it once the Mainnet
# fee payer, treasury and minting-key setup are checked (recovery/burn are already held by each college's officials). Devnet is never locked.
MAINNET_KEY_CUSTODY_APPROVED=
# Claims pause (503, nothing charged) when the fee payer holds less than this many SOL. Default 0.05.
FEE_PAYER_MIN_SOL=
# Tests only: turn the per-IP rate limits off.
RATE_LIMIT_DISABLED=
# https://app.degreenft.com,http://localhost:5173. Empty = FRONTEND_URL is used.
CORS_ORIGINS=
